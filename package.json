{
  "name": "peptomoon-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:placeholders && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:content",
    "capture:portfolio": "tsx scripts/capture-portfolio.ts",
    "import:gsc": "tsx scripts/import-gsc.ts",
    "make:og": "tsx scripts/make-og.ts",
    "test:e2e": "playwright test",
    "shoot": "tsx scripts/shoot.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "16.4.6",
    "@radix-ui/react-icons": "^1.3.2",
    "clsx": "^2.1.1",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "resend": "6.38.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
