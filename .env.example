# Public site URL (no trailing slash). Decides canonical URLs, sitemap and Open Graph. Defaults to https://peptomoon.com in production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics and search (all optional). Analytics only loads after cookie consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Public contact address, shown across the site. Defaults to inquiry@peptomoon.com when not set.
NEXT_PUBLIC_CONTACT_EMAIL=inquiry@peptomoon.com

# Contact form delivery. Without RESEND_API_KEY the form reports an honest error and never fakes success.
RESEND_API_KEY=
# The sending address, on a domain verified in Resend. Only the address matters: the site sets the sender name itself
# ("Peptomoon Website" on the alert we receive, "Peptomoon" on the confirmation the visitor receives).
# Use a different address from the one that receives leads, so the alert is not sent from the inbox it lands in.
RESEND_FROM_EMAIL=noreply@peptomoon.com
# Where enquiries are delivered. Leave empty to use inquiry@peptomoon.com. To also keep a backup copy, list both,
# separated by a comma: inquiry@peptomoon.com,peptomoon@gmail.com
INQUIRY_TO_EMAIL=

# Contact form spam check: a simple arithmetic question signed by this server. No outside service and no keys are needed.
# Optional: set a long random value so the signature key is yours alone.
FORM_SECRET=

# Future: WhatsApp Cloud API notifier (adapter exists, disabled until configured)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=
