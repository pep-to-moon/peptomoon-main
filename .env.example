# Public site URL (no trailing slash). Decides canonical URLs, sitemap and Open Graph. Defaults to https://peptomoon.com in production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics and search (all optional). Analytics only loads after cookie consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Public contact address. Defaults to peptomoon@gmail.com when not set.
NEXT_PUBLIC_CONTACT_EMAIL=peptomoon@gmail.com

# Contact form delivery. Without RESEND_API_KEY the form reports an honest error and never fakes success.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Peptomoon <noreply@peptomoon.com>
INQUIRY_TO_EMAIL=

# Spam protection (Cloudflare Turnstile). Dev test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Future: WhatsApp Cloud API notifier (adapter exists, disabled until configured)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=
